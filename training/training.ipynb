  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clean text\n",
    "df_load['title'] = df_load['title'].str.lower().str.replace('[^\\w\\s]', '', regex=True).fillna('')\n",
    "df_load['subtitle'] = df_load['subtitle'].str.lower().str.replace('[^\\w\\s]', '', regex=True).fillna('')\n",
    "df_load['combined_text'] = df_load['title'] + ' ' + df_load['subtitle']\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Encode labels\n",
    "le = LabelEncoder()\n",
    "df_load['productType_encoded'] = le.fit_transform(df_load['productType'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Split data\n",
    "X_train, X_test, y_train, y_test = train_test_split(df_load['combined_text'], df_load['productType_encoded'], \n",
    "                                                    test_size=0.2, stratify=df_load['productType_encoded'], random_state=42)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [
